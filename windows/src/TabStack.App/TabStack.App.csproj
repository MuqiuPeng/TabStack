<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TabStack</AssemblyName>
    <RootNamespace>TabStack.App</RootNamespace>
    <ApplicationIcon>Assets\TabStack.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <StartupObject>TabStack.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF and WinForms share type names; only NotifyIcon comes from WinForms. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\TabStack.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TabStack.Core\TabStack.Core.csproj" />
    <ProjectReference Include="..\TabStack.Platform.Windows\TabStack.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
